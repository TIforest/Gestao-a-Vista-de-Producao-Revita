{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revita-painel-producao",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Painel estático (public/) servido pelo mesmo Worker.
  // Rotas /api/* sempre passam pelo Worker; o resto é servido como asset.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Preencher database_id após rodar: wrangler d1 create revita-producao-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revita-producao-db",
      "database_id": "f979c702-a1d3-4ef1-af03-2669ea79a003",
      "migrations_dir": "./migrations"
    }
  ],

  // Verifica o Excel do SharePoint a cada 1 minuto (checagem barata via
  // lastModifiedDateTime); só baixa/reprocessa a planilha quando ela
  // realmente mudou. Veja SETUP.md sobre o limite de CPU do plano Free.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    "DESAGUADORAS": "01,02,03,04",
    "TURMAS": "A,B,C,D,E"
  }

  // "limits": { "cpu_ms": ... } fica de fora de propósito: o plano Free
  // rejeita o deploy inteiro se esse campo existir ("CPU limits are not
  // supported for the Free plan"). Só adicionar depois de migrar pro Paid.
}
